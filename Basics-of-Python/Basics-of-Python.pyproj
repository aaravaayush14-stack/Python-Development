<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>f78b4c54-4ee2-4640-9691-91b36dd2d27f</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>BasicsStuff\Boring_Stuff.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>Basics-of-Python</Name>
    <RootNamespace>Basics-of-Python</RootNamespace>
    <InterpreterId>MSBuild|env|$(MSBuildProjectFullPath)</InterpreterId>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BasicsStuff\Bool-and-Operators.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="BasicsStuff\Boring_Stuff.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="BasicsStuff\Conditionals.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="BasicsStuff\DataTypes-and-Numbers.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="BasicsStuff\Dictionaries.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="BasicsStuff\Functions.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="BasicsStuff\Lists.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="BasicsStuff\Loops.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="BasicsStuff\Printing.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="BasicsStuff\Sets.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="BasicsStuff\Strings.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="BasicsStuff\Test_Module.py">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="BasicsStuff\Tuple.py" />
    <Compile Include="BasicsStuff\Variables-Usage.py">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="NumPy\" />
    <Folder Include="BasicsStuff\" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include="env\">
      <Id>env</Id>
      <Version>3.14</Version>
      <Description>env (Python 3.14.5)</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Uncomment the CoreCompile target to enable the Build command in
       Visual Studio and specify your pre- and post-build commands in
       the BeforeBuild and AfterBuild targets below. -->
  <!--<Target Name="CoreCompile" />-->
